<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" VerticalOptions="Center">

            <Image Source="logo_hotel.png"
                   HeightRequest="130"
                   WidthRequest="130"
                   HorizontalOptions="Center" />

            <Label Text="{Binding NomeApp}"
                   FontFamily="Kalam"
                   FontSize="40"
                   TextColor="{StaticResource Primary}" />

            <Label Text="{Binding Versao, StringFormat='Versão {0}'}"
                   FontSize="14"
                   TextColor="{StaticResource Gray600}" />

            <Border BackgroundColor="White"
                    Stroke="{StaticResource PrimaryDark}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Desenvolvido por" FontSize="13" TextColor="{StaticResource Gray600}" />
                    <Label Text="{Binding Desenvolvedor}" FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <BoxView HeightRequest="1" Color="{StaticResource PrimaryDark}" />

                    <Label Text="Ano de desenvolvimento" FontSize="13" TextColor="{StaticResource Gray600}" />
                    <Label Text="{Binding AnoDesenvolvimento}" FontSize="20" FontAttributes="Bold" />

                    <BoxView HeightRequest="1" Color="{StaticResource PrimaryDark}" />

                    <Label Text="{Binding Escola}" FontAttributes="Bold" />
                    <Label Text="{Binding Curso}" />
                    <Label Text="{Binding Disciplina}" />

                    <BoxView HeightRequest="1" Color="{StaticResource PrimaryDark}" />

                    <Label Text="{Binding GitHub}" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Projeto App Hotel — .NET MAUI"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}" />

            <Button Text="Voltar" CornerRadius="12" Clicked="Voltar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
